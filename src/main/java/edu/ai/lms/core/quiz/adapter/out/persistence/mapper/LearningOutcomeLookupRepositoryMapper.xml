<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.ai.lms.core.quiz.adapter.out.persistence.LearningOutcomeLookupRepository">

  <select id="findExistingLearningOutcomeIdsByCourseIdAndIds" resultType="java.util.UUID">
    SELECT id
    FROM learning_outcomes
    WHERE course_id = #{courseId}
      AND id IN
      <foreach collection="learningOutcomeIds" item="learningOutcomeId" open="(" separator="," close=")">
        #{learningOutcomeId}
      </foreach>
  </select>

  <select id="findExistingGroupLearningOutcomeIdsByCourseIdAndIds" resultType="java.util.UUID">
    SELECT id
    FROM group_learning_outcomes
    WHERE course_id = #{courseId}
      AND id IN
      <foreach collection="groupLearningOutcomeIds" item="groupLearningOutcomeId" open="(" separator="," close=")">
        #{groupLearningOutcomeId}
      </foreach>
  </select>

  <select id="findLearningOutcomeIdsByCourseIdAndGroupIds" resultType="java.util.UUID">
    SELECT id
    FROM learning_outcomes
    WHERE course_id = #{courseId}
      AND group_learning_outcome_id IN
      <foreach collection="groupLearningOutcomeIds" item="groupLearningOutcomeId" open="(" separator="," close=")">
        #{groupLearningOutcomeId}
      </foreach>
  </select>

</mapper>
