<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.ai.lms.core.notification.adapter.out.persistence.CourseAnnouncementRepository">

    <resultMap id="AnnouncementResultMap" type="edu.ai.lms.core.notification.app.domain.CourseAnnouncement">
        <id property="id" column="id"/>
        <result property="courseId" column="course_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="type" column="type"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO course_announcements (id, course_id, title, content, teacher_id, type, created_at)
        VALUES (#{id}, #{courseId}, #{title}, #{content}, #{teacherId}, #{type}, #{createdAt})
    </insert>

    <select id="findByCourseId" resultMap="AnnouncementResultMap">
        SELECT * FROM course_announcements 
        WHERE course_id = #{courseId}
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCourseId" resultType="long">
        SELECT COUNT(*) FROM course_announcements WHERE course_id = #{courseId}
    </select>

    <select id="findById" resultMap="AnnouncementResultMap">
        SELECT * FROM course_announcements WHERE id = #{id}
    </select>

</mapper>
