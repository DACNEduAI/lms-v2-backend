# Application
PROFILE=dev
DATABASE_INITIALIZATION_OPTION=never
APP_LOG_LEVEL=INFO

# PostgreSQL
DATA_SOURCE=jdbc:postgresql://<host>:5432/<database>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>

# Authentication
JWT_KEY=<jwt-signing-secret>
JWT_EXPIRATION=86400000

# Supabase Storage S3
STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=<project-region>
STORAGE_S3_ACCESS_KEY_ID=<access-key>
STORAGE_S3_SECRET_ACCESS_KEY=<secret-key>
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PRIVATE_BUCKET=<private-bucket>
STORAGE_PUBLIC_BUCKET=<public-bucket>
STORAGE_SIGNED_URL_TTL_SECONDS=900

# BE -> AI service authentication. Keep this value identical to
# AI_Pipeline/.env; never expose it to the frontend.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=<shared-ai-service-token>
